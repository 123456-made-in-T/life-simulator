[
  { "id": "e001", "realmMax": 0, "ageMax": 3, "once": true, "weight": 2, "text": "你呱呱坠地。产婆说你哭声洪亮，是个有福气的。" },
  { "id": "e002", "realmMax": 0, "ageMin": 1, "ageMax": 5, "once": true, "text": "你在河边玩水险些溺亡，被一位游方道人所救。道人看了看你的骨相，若有所思地离去。", "effects": { "tipo": 1 } },
  { "id": "e003", "realmMax": 0, "ageMin": 3, "ageMax": 6, "once": true, "cond": { "minAttrs": { "jiashi": 6 } }, "text": "家中重金请来测灵师为你测灵根，测灵盘光华大放，全家欣喜若狂。", "effects": { "daoxin": 1 } },
  { "id": "e004", "realmMax": 0, "ageMin": 3, "ageMax": 7, "once": true, "cond": { "maxAttrs": { "jiashi": 3 } }, "text": "家中贫寒，你从小跟着爹娘下地干活，晒得黢黑，却也筋骨结实。", "effects": { "tipo": 1 } },
  { "id": "e005", "realmMax": 0, "ageMin": 5, "ageMax": 10, "once": true, "text": "村口老槐树下，说书先生讲起仙人御剑飞天的故事，你听得入了迷，在心里埋下一颗种子。", "effects": { "daoxin": 1 } },
  { "id": "e006", "realmMax": 0, "ageMin": 6, "ageMax": 12, "once": true, "cond": { "minAttrs": { "wuxing": 6 } }, "text": "私塾先生惊叹你读书过目成诵，连称『此子非池中之物』。", "effects": { "wuxing": 1 } },
  { "id": "e007", "realmMax": 0, "ageMin": 6, "ageMax": 14, "text": "你上山采药补贴家用，认识了不少草药。", "effects": { "wuxing": 1 } },
  { "id": "e008", "realmMax": 0, "ageMin": 8, "ageMax": 14, "text": "山中遇到野狼！你连滚带爬逃了回来。", "effects": { "tipo": 1, "daoxin": -1 }, "deathChance": 0.03, "deathText": "你没能跑过狼群，一条小命葬送山野。" },
  { "id": "e009", "realmMax": 0, "ageMin": 10, "ageMax": 16, "once": true, "cond": { "talent": "jiangu" }, "text": "你捡到一柄锈剑，握住剑柄的一瞬，血脉里似有嗡鸣回应。", "effects": { "cultivation": 10, "daoxin": 1 }, "achievement": "剑缘初结" },
  { "id": "e010", "realmMax": 0, "ageMin": 10, "ageMax": 18, "once": true, "cond": { "minAttrs": { "linggen": 5 } }, "text": "仙门下山招收弟子！你在测灵大典上灵光冲霄，被执事长老当场收入门墙。", "effects": { "cultivation": 20, "daoxin": 1 }, "achievement": "踏入仙门" },
  { "id": "e011", "realmMax": 0, "ageMin": 10, "ageMax": 18, "once": true, "cond": { "maxAttrs": { "linggen": 4 }, "minAttrs": { "jiashi": 7 } }, "text": "灵根平平的你靠家中重礼打点，勉强进了一家小宗门做外门杂役。", "effects": { "cultivation": 10 } },
  { "id": "e012", "realmMax": 0, "ageMin": 12, "ageMax": 20, "once": true, "cond": { "flag": "qiyun" }, "text": "你在后山迷路，误入一处废弃洞府，得到半卷无名功法！", "effects": { "cultivation": 30, "linggen": 1 }, "achievement": "洞府奇遇" },
  { "id": "e013", "realmMax": 0, "ageMin": 14, "ageMax": 25, "once": true, "cond": { "flag": "meimao" }, "text": "镇上首富看中你的容貌，想招你入赘。你婉言谢绝，一心向道。", "effects": { "daoxin": 1 } },
  { "id": "e014", "realmMax": 0, "ageMin": 6, "weight": 3, "text": "平平淡淡又一年，你日出而作，日落而息。" },
  { "id": "e015", "realmMax": 0, "ageMin": 16, "ageMax": 60, "cond": { "maxAttrs": { "linggen": 2 } }, "weight": 2, "text": "你渐渐认了命：仙缘渺茫，不如把眼前的日子过好。", "effects": { "daoxin": 1 } },
  { "id": "e016", "realmMax": 0, "ageMin": 18, "ageMax": 50, "once": true, "cond": { "maxAttrs": { "linggen": 3 } }, "text": "你成了亲，伴侣温柔体贴，日子清贫却安稳。", "effects": { "daoxin": 2, "tipo": 1 } },
  { "id": "e017", "realmMax": 0, "ageMin": 6, "ageMax": 30, "once": true, "text": "瘟疫过境，村里病倒了一大片。", "effects": { "tipo": -1 }, "deathChance": 0.04, "deathText": "你没能熬过这场瘟疫。" },
  { "id": "e018", "realmMin": 1, "realmMax": 1, "once": true, "weight": 2, "text": "初入练气，你第一次感受到灵气在经脉中流转，如溪流淌过周身，妙不可言。", "effects": { "daoxin": 1 } },
  { "id": "e019", "realmMin": 1, "realmMax": 1, "text": "你在门中领了洒扫任务，一边扫地一边吐纳，倒也两不耽误。", "effects": { "cultivation": 5 } },
  { "id": "e020", "realmMin": 1, "realmMax": 2, "cond": { "minAttrs": { "wuxing": 6 } }, "text": "夜观星斗，你对功法中一处晦涩经文豁然开朗。", "effects": { "cultivation": 15 } },
  { "id": "e021", "realmMin": 1, "realmMax": 2, "text": "同门师兄以切磋为名下狠手，你被打得吐血，躺了半个月。", "effects": { "tipo": -1, "daoxin": -1 } },
  { "id": "e022", "realmMin": 1, "realmMax": 2, "once": true, "cond": { "flag": "shijia" }, "text": "家族送来一批灵石丹药，助你修行一臂之力。", "effects": { "cultivation": 25 } },
  { "id": "e023", "realmMin": 1, "realmMax": 2, "once": true, "cond": { "flag": "dandao" }, "text": "你在丹房帮工时指出一炉丹药火候之误，丹长老抚须大笑，收你做了记名弟子。", "effects": { "cultivation": 15, "jiashi": 1 }, "achievement": "丹道入门" },
  { "id": "e024", "realmMin": 1, "realmMax": 1, "once": true, "text": "坊市偶遇一位摆摊老者，他送你一枚不起眼的木牌，说日后自有用处。", "effects": { "flag": "mupai" } },
  { "id": "e025", "realmMin": 1, "realmMax": 2, "text": "灵田除虫、伙房烧火、藏经阁抄书……杂役岁月枯燥，你的心性却磨得愈发坚韧。", "effects": { "daoxin": 1 } },
  { "id": "e026", "realmMin": 1, "realmMax": 2, "once": true, "cond": { "minAttrs": { "daoxin": 7 } }, "text": "宗门大比，你以下克上连胜三场，一战成名！", "effects": { "cultivation": 20, "jiashi": 1 }, "achievement": "大比扬名" },
  { "id": "e027", "realmMin": 1, "realmMax": 2, "text": "你下山历练，路遇山贼劫道。", "effects": { "tipo": 1 }, "deathChance": 0.03, "deathText": "山贼人多势众，你交代在了荒山野岭。" },
  { "id": "e028", "realmMin": 1, "realmMax": 2, "once": true, "text": "你对一位同门暗生情愫，几次欲言又止，终究把心事压进了丹田。", "effects": { "daoxin": -1, "cultivation": 5 } },
  { "id": "e029", "realmMin": 1, "realmMax": 6, "weight": 3, "text": "闭关苦修，寒来暑往，修为稳步精进。", "effects": { "cultivation": 10 } },
  { "id": "e030", "realmMin": 1, "realmMax": 2, "once": true, "cond": { "flag": "qiyun" }, "text": "雷雨夜，一道紫雷劈中你门前古树，树心中竟藏着一枚雷灵果！", "effects": { "linggen": 1, "cultivation": 20 }, "achievement": "雷灵造化" },
  { "id": "e031", "realmMin": 1, "realmMax": 2, "cond": { "maxAttrs": { "jiashi": 2 } }, "text": "囊中羞涩，你连最便宜的聚气丹都买不起，只能靠打坐硬熬。", "effects": { "daoxin": -1, "cultivation": 3 } },
  { "id": "e032", "realmMin": 1, "realmMax": 2, "once": true, "text": "一场大战波及山门，你随众撤离，亲眼见识了金丹修士移山填海的恐怖伟力。", "effects": { "daoxin": 1 } },
  { "id": "e033", "realmMax": 0, "ageMin": 55, "weight": 2, "text": "你坐在村口晒太阳，给孙辈讲年轻时差点遇仙的故事，孩子们听得眼睛发亮。", "effects": { "daoxin": 1 } },
  { "id": "e034", "realmMax": 0, "ageMin": 50, "weight": 2, "text": "岁月催人老，你的背驼了，眼也花了，好在儿孙孝顺，粗茶淡饭也有滋味。", "effects": { "tipo": -1, "daoxin": 1 } },
  { "id": "e035", "realmMax": 0, "ageMin": 60, "once": true, "text": "花甲寿宴，全村人都来道贺。你举杯环顾，恍惚觉得这辈子虽无仙缘，也算圆满。", "effects": { "daoxin": 1 } }
]
