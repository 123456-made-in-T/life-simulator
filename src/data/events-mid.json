[
  { "id": "m001", "realmMin": 2, "realmMax": 2, "once": true, "weight": 2, "text": "筑基功成，你被提拔为内门弟子，分到一座带灵田的小院。", "effects": { "jiashi": 1, "daoxin": 1 } },
  { "id": "m002", "realmMin": 2, "realmMax": 3, "text": "你入秘境历练，采得数株百年灵药。", "effects": { "cultivation": 15 } },
  { "id": "m003", "realmMin": 2, "realmMax": 3, "text": "秘境深处魔兽暴起发难！", "effects": { "cultivation": 10 }, "deathChance": 0.05, "deathText": "魔兽利爪撕裂了你的护体灵光，你陨落在秘境之中。" },
  { "id": "m004", "realmMin": 2, "realmMax": 3, "once": true, "cond": { "flag": "jiandao" }, "text": "剑冢之中，一柄断剑认你为主。从此你的剑快了三分。", "effects": { "cultivation": 20, "tipo": 1 }, "achievement": "断剑认主" },
  { "id": "m005", "realmMin": 2, "realmMax": 3, "once": true, "cond": { "minAttrs": { "daoxin": 6 } }, "text": "你与一位志同道合的修士结为道侣，从此修行路上有人共剪烛花。", "effects": { "daoxin": 2 }, "achievement": "结为道侣" },
  { "id": "m006", "realmMin": 2, "realmMax": 3, "once": true, "cond": { "flag": "mupai" }, "text": "你随手把玩那枚旧木牌，牌中竟浮现一篇上古炼体诀！", "effects": { "tipo": 2, "cultivation": 20 }, "achievement": "木牌之秘" },
  { "id": "m007", "realmMin": 2, "realmMax": 3, "text": "宗门派你驻守矿脉，与魔修爆发遭遇战。", "effects": { "cultivation": 10, "daoxin": -1 }, "deathChance": 0.04, "deathText": "魔修一记阴毒法术透体而过，你力战而亡。" },
  { "id": "m008", "realmMin": 2, "realmMax": 3, "once": true, "cond": { "flag": "dandao" }, "text": "你闭门三月，炼出人生第一炉筑基丹，丹香十里，轰动坊市。", "effects": { "jiashi": 2, "cultivation": 10 }, "achievement": "丹成一品" },
  { "id": "m009", "realmMin": 2, "realmMax": 3, "cond": { "maxAttrs": { "daoxin": 4 } }, "text": "修行瓶颈难破，你烦躁易怒，隐隐有心魔滋生之兆。", "effects": { "daoxin": -1 } },
  { "id": "m010", "realmMin": 2, "realmMax": 3, "once": true, "text": "云游途中，你在一座荒村施药救人，村民为你立了长生牌位。", "effects": { "daoxin": 2 }, "achievement": "善名远播" },
  { "id": "m011", "realmMin": 2, "realmMax": 3, "once": true, "cond": { "flag": "qiyun" }, "text": "一场拍卖会上，你以低价拍得一件蒙尘古镜，事后发现竟是上古灵宝！", "effects": { "jiashi": 2, "cultivation": 15 }, "achievement": "慧眼识宝" },
  { "id": "m012", "realmMin": 3, "realmMax": 3, "once": true, "weight": 2, "text": "金丹既成，你受邀在宗门开坛讲道，台下白发长老亦凝神倾听。", "effects": { "daoxin": 1, "jiashi": 1 }, "achievement": "开坛讲道" },
  { "id": "m013", "realmMin": 3, "realmMax": 4, "text": "你游历四海，于山川湖海间印证道法。", "effects": { "cultivation": 12, "daoxin": 1 } },
  { "id": "m014", "realmMin": 3, "realmMax": 4, "text": "海外寻宝，遭遇风暴与海兽双重夹击。", "effects": { "cultivation": 10 }, "deathChance": 0.05, "deathText": "怒海无情，你葬身于万丈波涛。" },
  { "id": "m015", "realmMin": 3, "realmMax": 4, "once": true, "cond": { "minAttrs": { "wuxing": 8 } }, "text": "你于瀑布下枯坐七日，顿悟水行真意，修为一日千里。", "effects": { "cultivation": 40 }, "achievement": "悟道七日" },
  { "id": "m016", "realmMin": 3, "realmMax": 4, "once": true, "text": "昔日欺辱你的师兄如今见你需仰视，你一笑置之，心境圆融。", "effects": { "daoxin": 2 } },
  { "id": "m017", "realmMin": 3, "realmMax": 4, "text": "魔道大举来犯，你随宗门迎战，血染长空。", "effects": { "cultivation": 15, "tipo": -1 }, "deathChance": 0.06, "deathText": "乱战之中，你被数名魔修围攻，油尽灯枯。" },
  { "id": "m018", "realmMin": 3, "realmMax": 4, "once": true, "cond": { "flag": "shijia" }, "text": "家族没落，族老跪求你出山主持大局。你重振家声，桑梓皆传佳话。", "effects": { "jiashi": 2, "daoxin": 1 }, "achievement": "重振家声" },
  { "id": "m019", "realmMin": 2, "realmMax": 4, "cond": { "maxAttrs": { "tipo": 3 } }, "text": "旧伤复发，你咳血不止，闭关养伤耽误了修行。", "effects": { "cultivation": -10, "tipo": 1 } },
  { "id": "m020", "realmMin": 3, "realmMax": 4, "once": true, "text": "你收下第一位亲传弟子。看着少年懵懂的眼睛，你仿佛看到当年的自己。", "effects": { "daoxin": 1 }, "achievement": "传道授业" },
  { "id": "m021", "realmMin": 2, "realmMax": 3, "text": "灵石告急，你接下宗门悬赏猎杀妖兽，风餐露宿数月。", "effects": { "jiashi": 1, "tipo": 1 } },
  { "id": "m022", "realmMin": 3, "realmMax": 4, "once": true, "cond": { "flag": "meimao" }, "text": "魔道圣女对你一见倾心，以双修功法相诱。你不为所动，全身而退。", "effects": { "daoxin": 1 }, "achievement": "坐怀不乱" }
]
