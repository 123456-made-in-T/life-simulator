.masthead {
  position: relative;
  text-align: center;
  padding: 24rpx 0 12rpx;
  border-bottom: 4rpx solid var(--ink);
  margin: 0 24rpx 8rpx;
}

.music-toggle {
  position: absolute;
  top: 28rpx;
  right: 0;
  font-size: 24rpx;
  color: var(--ink-soft);
  border: 1rpx solid var(--line);
  border-radius: 4rpx;
  padding: 4rpx 16rpx;
}

.title {
  font-size: 64rpx;
  font-weight: 600;
  letter-spacing: 0.6em;
  text-indent: 0.6em;
}

.subtitle {
  color: var(--ink-soft);
  font-size: 24rpx;
  letter-spacing: 0.15em;
}

.warn {
  color: var(--cinnabar);
  font-weight: 600;
}

.modes {
  display: flex;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.mode {
  flex: 1;
  text-align: center;
  padding: 8rpx 0;
  border: 1rpx solid var(--line);
  border-radius: 4rpx;
  color: var(--ink-soft);
  font-size: 28rpx;
}

.mode.active {
  background: var(--indigo);
  border-color: var(--indigo);
  color: var(--paper);
}

.mode-desc {
  font-size: 22rpx;
  color: var(--ink-soft);
  margin-bottom: 12rpx;
}

.boons {
  border: 1rpx dashed var(--gold);
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
}

.boons-title {
  color: var(--gold);
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.boons-hint {
  font-weight: 400;
  color: var(--ink-soft);
  font-size: 22rpx;
}

.boon-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.boon {
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border: 1rpx solid var(--line);
  border-radius: 4rpx;
  color: var(--ink-soft);
}

.boon.active {
  background: var(--gold);
  border-color: var(--gold);
  color: var(--paper);
}

.boon.dim {
  opacity: 0.4;
}

/* ---------- 资质分配 ---------- */

.attr-row {
  padding: 16rpx 0;
  border-bottom: 1rpx dashed var(--line);
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
}

.attr-name {
  font-size: 32rpx;
}

.attr-hint {
  font-size: 22rpx;
  color: var(--ink-soft);
}

.attr-ctrl {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.btn.mini {
  width: 64rpx;
  height: 64rpx;
  padding: 0;
  line-height: 60rpx;
  text-align: center;
}

.attr-value {
  min-width: 1.6em;
  text-align: center;
  font-size: 36rpx;
  font-weight: 600;
}

.attr-bar {
  width: 100%;
  height: 8rpx;
  background: var(--paper-deep);
  margin-top: 12rpx;
}

.attr-fill {
  height: 100%;
  background: var(--indigo);
  transition: width 240ms ease-out;
}

.actions {
  display: flex;
  justify-content: space-between;
  margin-top: 40rpx;
}

.actions-left {
  display: flex;
  gap: 16rpx;
}

/* ---------- 生平战绩 ---------- */

.career {
  display: flex;
  justify-content: space-between;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--line);
  margin-bottom: 24rpx;
}

.stat {
  text-align: center;
}

.stat-label {
  font-size: 22rpx;
  color: var(--ink-soft);
}

.stat-value {
  font-size: 32rpx;
  font-weight: 600;
}

.records-empty {
  text-align: center;
  color: var(--ink-soft);
  padding: 60rpx 0;
}

.records-list {
  max-height: 55vh;
  margin-bottom: 24rpx;
}

.record-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx dashed var(--line);
  font-size: 26rpx;
}

.rr-grade {
  flex-shrink: 0;
  width: 1.8em;
  text-align: center;
  font-weight: 700;
  color: var(--indigo);
}

.rr-main {
  flex: 1;
}

.rr-date {
  color: var(--ink-soft);
  font-size: 22rpx;
  margin-left: 10rpx;
}

.rr-score {
  flex-shrink: 0;
  font-weight: 600;
}

.ach-toggle {
  display: inline-block;
  font-size: 24rpx;
  color: var(--gold);
  border: 1rpx solid var(--gold);
  border-radius: 4rpx;
  padding: 6rpx 24rpx;
  margin-bottom: 16rpx;
}

.ach-list {
  max-height: 45vh;
  border: 1rpx solid var(--line);
  padding: 8rpx 20rpx;
  margin-bottom: 24rpx;
}

.ach-row {
  display: flex;
  gap: 20rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx dashed var(--line);
  font-size: 25rpx;
}

.ach-name {
  flex-shrink: 0;
  min-width: 6.5em;
  color: var(--ink-soft);
}

.ach-row.done .ach-name {
  color: var(--gold);
  font-weight: 600;
}

.ach-hint {
  color: var(--ink-soft);
  font-size: 22rpx;
}

.actions.end {
  justify-content: flex-end;
}

/* ---------- 命格 ---------- */

.talent {
  border: 1rpx solid var(--line);
  border-left-width: 6rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
}

.talent.picked {
  background: var(--ink);
  color: var(--paper);
}

.rarity-1 { border-left-color: var(--ink-soft); }
.rarity-2 { border-left-color: var(--indigo); }
.rarity-3 { border-left-color: var(--gold); }

.talent-name {
  font-weight: 600;
  margin-right: 16rpx;
}

.talent-rarity {
  font-size: 22rpx;
  color: var(--ink-soft);
  margin-right: 16rpx;
}

.talent.picked .talent-rarity {
  color: var(--paper-deep);
}

.talent-desc {
  font-size: 26rpx;
}

/* ---------- 人生进行中 ---------- */

.life {
  display: flex;
  flex-direction: column;
  height: calc(100vh - 160rpx);
  padding: 0 24rpx;
}

.status {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx 24rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.realm-badge {
  background: var(--indigo);
  color: var(--paper);
  padding: 2rpx 20rpx;
  font-size: 26rpx;
  letter-spacing: 0.2em;
}

.origin-badge {
  border: 1rpx solid var(--line);
  color: var(--ink-soft);
  padding: 2rpx 16rpx;
  font-size: 22rpx;
}

.artifact-badge {
  border: 1rpx solid var(--gold);
  color: var(--gold);
  padding: 2rpx 16rpx;
  font-size: 22rpx;
}

.age {
  font-size: 32rpx;
  font-weight: 600;
}

.lifespan {
  font-weight: 400;
  font-size: 24rpx;
  color: var(--ink-soft);
}

.cult-bar {
  flex: 1;
  min-width: 120rpx;
  height: 10rpx;
  background: var(--paper-deep);
}

.cult-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--indigo), var(--gold));
  transition: width 240ms ease-out;
}

.attrs {
  width: 100%;
  display: flex;
  gap: 24rpx;
  font-size: 24rpx;
  color: var(--ink-soft);
}

.log-scroll {
  flex: 1;
  min-height: 0;
  padding: 16rpx 0;
}

.log {
  display: flex;
  gap: 20rpx;
  margin-bottom: 14rpx;
}

.log-age {
  flex-shrink: 0;
  min-width: 4em;
  text-align: right;
  color: var(--ink-soft);
  font-size: 24rpx;
  padding-top: 4rpx;
}

.log-text {
  font-size: 28rpx;
}

.tone-bad .log-text { color: #7a4a1e; }
.tone-choice .log-text { color: var(--indigo); }
.tone-breakthrough .log-text { color: var(--indigo); font-weight: 600; }
.tone-death .log-text { color: var(--cinnabar); font-weight: 600; }
.tone-ascend .log-text { color: var(--gold); font-weight: 700; }

.controls {
  display: flex;
  justify-content: flex-end;
  padding: 16rpx 0 24rpx;
  border-top: 1rpx solid var(--line);
}

.choices {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 16rpx 0 24rpx;
  border-top: 4rpx solid var(--cinnabar);
}

.choice-btn {
  text-align: left;
  border-color: var(--cinnabar);
  color: var(--cinnabar);
  padding: 16rpx 24rpx;
}

.btn.small {
  font-size: 26rpx;
  padding: 8rpx 24rpx;
}

/* ---------- 结算 ---------- */

.summary {
  text-align: center;
}

.grade {
  font-size: 120rpx;
  font-weight: 700;
  line-height: 1;
}

/* WXSS 不支持中文类名，评级样式用拼音/字母类名（页面 JS 里做映射） */
.grade-immortal { color: var(--gold); }
.grade-s { color: var(--cinnabar); }
.grade-a { color: var(--indigo); }
.grade-b, .grade-c, .grade-d { color: var(--ink-soft); }

.summary-title {
  font-size: 44rpx;
  letter-spacing: 0.3em;
  text-indent: 0.3em;
  font-weight: 600;
  margin: 8rpx 0 16rpx;
}

.ending {
  color: var(--ink-soft);
  font-size: 27rpx;
  margin-bottom: 40rpx;
}

.facts {
  display: flex;
  justify-content: center;
  gap: 48rpx;
  margin-bottom: 40rpx;
}

.fact-label {
  font-size: 22rpx;
  color: var(--ink-soft);
}

.fact-value {
  font-size: 36rpx;
  font-weight: 600;
}

.ach-title {
  font-size: 28rpx;
  letter-spacing: 0.2em;
  margin-bottom: 12rpx;
}

.ach-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 32rpx;
}

.ach {
  border: 1rpx solid var(--gold);
  color: var(--gold);
  font-size: 24rpx;
  padding: 2rpx 20rpx;
}

.seed {
  font-size: 22rpx;
  color: var(--ink-soft);
  margin-bottom: 32rpx;
}

.mode-tag {
  font-size: 24rpx;
  color: var(--ink-soft);
  letter-spacing: 0.15em;
  margin: -8rpx 0 16rpx;
}

.fruits {
  color: var(--gold);
  font-weight: 600;
  font-size: 28rpx;
  margin-bottom: 8rpx;
}

.fruits-total {
  font-weight: 400;
  font-size: 22rpx;
  color: var(--ink-soft);
}

.share-btn {
  display: inline-block;
  font-size: 26rpx;
  color: var(--gold);
  border: 1rpx solid var(--gold);
  border-radius: 4rpx;
  padding: 8rpx 32rpx;
  margin-bottom: 16rpx;
}

.share-canvas {
  position: fixed;
  left: 9999rpx;
  top: 0;
  width: 750px;
  height: 1100px;
}

.record-toggle {
  display: inline-block;
  font-size: 24rpx;
  color: var(--ink-soft);
  border: 1rpx solid var(--line);
  border-radius: 4rpx;
  padding: 6rpx 24rpx;
  margin-bottom: 16rpx;
}

.record-list {
  max-height: 50vh;
  text-align: left;
  border: 1rpx solid var(--line);
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
  font-size: 25rpx;
}

.record-line {
  margin-bottom: 12rpx;
}

.record-age {
  color: var(--ink-soft);
  font-size: 22rpx;
  margin-right: 12rpx;
}

.record-line.tone-breakthrough { color: var(--indigo); }
.record-line.tone-death { color: var(--cinnabar); }
.record-line.tone-ascend { color: var(--gold); }

.restart {
  font-size: 32rpx;
  padding: 14rpx 80rpx;
}
