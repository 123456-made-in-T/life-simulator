<view class="masthead">
  <view class="title">问道</view>
  <view class="subtitle">修仙人生模拟器 · 一念入道，百年浮生</view>
  <view class="music-toggle" bindtap="onToggleMusic">{{musicOn ? '♪ 乐' : '♪ 静'}}</view>
</view>

<!-- 资质分配 -->
<view class="panel" wx:if="{{phase === 'setup'}}">
  <view class="section-title">投胎 · 分配资质</view>

  <view class="modes">
    <view
      wx:for="{{difficulties}}"
      wx:key="id"
      class="mode {{difficultyId === item.id ? 'active' : ''}}"
      data-id="{{item.id}}"
      bindtap="onSelectDifficulty"
    >{{item.name}}</view>
  </view>
  <view class="mode-desc">{{difficultyDesc}}</view>

  <view class="hint">剩余点数：<text class="{{remaining !== 0 ? 'warn' : ''}}">{{remaining}}</text> / {{pointTotal}}</view>

  <view class="attr-row" wx:for="{{allocKeys}}" wx:for-item="key" wx:key="*this">
    <view class="attr-name">
      {{attrLabels[key]}}
      <view class="attr-hint">{{attrHints[key]}}</view>
    </view>
    <view class="attr-ctrl">
      <view class="btn mini" hover-class="btn-hover" data-key="{{key}}" data-delta="-1" bindtap="onAdjust">−</view>
      <text class="attr-value">{{alloc[key]}}</text>
      <view class="btn mini" hover-class="btn-hover" data-key="{{key}}" data-delta="1" bindtap="onAdjust">＋</view>
    </view>
    <view class="attr-bar"><view class="attr-fill" style="width: {{alloc[key] * 10}}%"></view></view>
  </view>

  <view class="actions">
    <view class="actions-left">
      <view class="btn" hover-class="btn-hover" bindtap="onRandomize">听天由命</view>
      <view class="btn" hover-class="btn-hover" bindtap="onShowRecords">生平战绩</view>
    </view>
    <view class="btn primary {{remaining !== 0 ? 'disabled' : ''}}" bindtap="onConfirmAlloc">入世投胎</view>
  </view>
</view>

<!-- 生平战绩 -->
<view class="panel" wx:elif="{{phase === 'records'}}">
  <view class="section-title">生平战绩</view>

  <view class="career">
    <view class="stat"><view class="stat-label">轮回</view><view class="stat-value">{{career.total}} 世</view></view>
    <view class="stat"><view class="stat-label">最高评分</view><view class="stat-value">{{career.bestScore}}</view></view>
    <view class="stat"><view class="stat-label">飞升</view><view class="stat-value">{{career.ascensions}} 次</view></view>
    <view class="stat"><view class="stat-label">最高寿数</view><view class="stat-value">{{career.maxAge}} 岁</view></view>
  </view>

  <view wx:if="{{records.length === 0}}" class="records-empty">尚无一世修行。回去投个胎吧。</view>
  <scroll-view wx:else scroll-y class="records-list">
    <view wx:for="{{records}}" wx:key="at" class="record-row">
      <text class="rr-grade">{{item.grade}}</text>
      <view class="rr-main">
        {{item.title}} · {{item.realmName}} · {{item.age}}岁 · {{item.difficultyName}}
        <text class="rr-date">{{item.dateText}}</text>
      </view>
      <text class="rr-score">{{item.score}}</text>
    </view>
  </scroll-view>

  <view class="actions">
    <view class="btn {{records.length === 0 ? 'disabled' : ''}}" hover-class="btn-hover" bindtap="onClearRecords">清空战绩</view>
    <view class="btn primary" hover-class="btn-hover" bindtap="onBackFromRecords">返回</view>
  </view>
</view>

<!-- 命格抽取 -->
<view class="panel" wx:elif="{{phase === 'talent'}}">
  <view class="section-title">抽取命格</view>
  <view class="hint">天命十签，择其三。（已选 {{selectedCount}} / {{pickCount}}）</view>

  <view
    class="talent rarity-{{item.rarity}} {{selectedMap[item.id] ? 'picked' : ''}}"
    wx:for="{{talentOptions}}"
    wx:key="id"
    data-id="{{item.id}}"
    bindtap="onToggleTalent"
  >
    <text class="talent-name">{{item.name}}</text>
    <text class="talent-rarity">{{rarityLabels[item.rarity]}}</text>
    <text class="talent-desc">{{item.desc}}</text>
  </view>

  <view class="actions end">
    <view class="btn primary {{selectedCount !== pickCount ? 'disabled' : ''}}" bindtap="onConfirmTalents">带此命格降生</view>
  </view>
</view>

<!-- 人生进行中 -->
<view class="life" wx:elif="{{phase === 'living'}}">
  <view class="status">
    <text class="realm-badge">{{view.realmName}}</text>
    <text class="origin-badge" wx:if="{{view.originName}}">{{view.originName}}</text>
    <text class="age">{{view.age}} 岁 <text class="lifespan">/ 寿元 {{view.lifespan}}</text></text>
    <view class="cult-bar"><view class="cult-fill" style="width: {{view.cultPercent}}%"></view></view>
    <view class="attrs">
      <text wx:for="{{view.attrs}}" wx:key="label" class="attr-chip">{{item.label}} {{item.value}}</text>
    </view>
  </view>

  <scroll-view class="log-scroll" scroll-y scroll-into-view="{{lastLogId}}" scroll-with-animation>
    <view class="log tone-{{item.tone}}" wx:for="{{logs}}" wx:key="index" id="log-{{index}}">
      <text class="log-age">{{item.age}}岁</text>
      <text class="log-text">{{item.text}}</text>
    </view>
    <view id="log-bottom"></view>
  </scroll-view>

  <view class="choices" wx:if="{{pendingOptions.length > 0}}">
    <view
      class="btn choice-btn"
      hover-class="btn-hover"
      wx:for="{{pendingOptions}}"
      wx:key="*this"
      data-index="{{index}}"
      bindtap="onChoose"
    >{{item}}</view>
  </view>
  <view class="controls" wx:else>
    <view class="btn small" hover-class="btn-hover" bindtap="onToggleSpeed">{{speed === 'slow' ? '光阴加速 »' : '细品岁月 «'}}</view>
  </view>
</view>

<!-- 结算 -->
<view class="panel summary" wx:elif="{{phase === 'summary'}}">
  <view class="grade grade-{{summary.gradeClass}}">{{summary.grade}}</view>
  <view class="summary-title">{{summary.title}}</view>
  <view class="mode-tag">{{summary.difficultyName}}模式</view>
  <view class="ending">{{summary.endingText}}</view>

  <view class="facts">
    <view class="fact"><view class="fact-label">终此一生</view><view class="fact-value">{{summary.age}} 岁</view></view>
    <view class="fact"><view class="fact-label">最终境界</view><view class="fact-value">{{summary.realmName}}</view></view>
    <view class="fact"><view class="fact-label">此生评分</view><view class="fact-value">{{summary.score}}</view></view>
  </view>

  <view class="achievements" wx:if="{{summary.achievements.length > 0}}">
    <view class="ach-title">此生高光</view>
    <view class="ach-list">
      <text class="ach" wx:for="{{summary.achievements}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <view class="seed">命盘编号 #{{seed}}</view>

  <view class="record-toggle" bindtap="onToggleRecord">{{showRecord ? '收起此生年表 ▲' : '回顾此生年表 ▼'}}</view>
  <scroll-view wx:if="{{showRecord}}" scroll-y class="record-list">
    <view wx:for="{{logs}}" wx:key="index" class="record-line tone-{{item.tone}}">
      <text class="record-age">{{item.age}}岁</text>{{item.text}}
    </view>
  </scroll-view>

  <view class="btn primary restart" hover-class="btn-hover" bindtap="onRestart">再入轮回</view>
</view>
